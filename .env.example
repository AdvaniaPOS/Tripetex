APP_NAME=tt-susoft-sync
APP_ENV=dev
APP_AUTO_CREATE_TABLES=true

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# Example: postgresql+psycopg://postgres:postgres@localhost:5432/tt_susoft
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tt_susoft

TRIPLETEX_BASE_URL=https://tripletex.no/v2
TRIPLETEX_CONSUMER_TOKEN=
TRIPLETEX_EMPLOYEE_TOKEN=
TRIPLETEX_TIMEZONE=Europe/Oslo

SYNC_DEFAULT_LIMIT=50

SUSOFT_BASE_URL=https://api.susoft.com:4443
SUSOFT_SHOP_URL_KEY=
SUSOFT_USERNAME=
SUSOFT_PASSWORD=

REQUEST_TIMEOUT_SECONDS=30
